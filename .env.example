# ==================================
# Tomo v2 — Environment Variables
# ==================================
# Copy this file to .env and adjust values as needed.
#
# For local development, the defaults below work out of the box.
# For Docker/production, override TOMO_DATA_DIR, PORT, and STATIC_DIR.

# ---- tomod (daemon) ----

# Data directory for config, secrets, and app data
# Development: ./data (relative to project root)
# Production:  /data (inside Docker container)
TOMO_DATA_DIR=./data

# HTTP server port (use 3001 for dev, 80 for production)
PORT=3001

# Directory containing the built frontend static files
# Development: ./packages/ui/dist
# Production:  /app
STATIC_DIR=./packages/ui/dist

# CORS origin — required for development (UI runs on a different port)
CORS_ORIGIN=http://localhost:5173

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ---- app-proxy (per-app auth sidecar) ----

# Proxy listening port
APP_PROXY_PORT=3000

# Target app container host
TARGET_HOST=localhost

# Target app container port
TARGET_PORT=8080

# JWT secret (optional — reads from $TOMO_DATA_DIR/secrets/jwt if not set)
# TOMO_JWT_SECRET=
